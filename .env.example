# Copy this file to .env and fill in your own values.
# Nothing here is required to run PaperPilot in mock mode (see README).

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to 1 to force mock mode even if ANTHROPIC_API_KEY is set (useful for
# demos/CI). If ANTHROPIC_API_KEY is empty, mock mode is used automatically.
PAPERPILOT_MOCK=0

# Max reasoning/tool-call steps per turn before the agent gives up.
PAPERPILOT_MAX_AGENT_STEPS=6

# --- Embeddings ---
# "local" (default): zero-dependency, works offline, lexical-overlap quality.
# "voyage": production-quality semantic embeddings via Voyage AI.
PAPERPILOT_EMBEDDING_BACKEND=local
VOYAGE_API_KEY=
PAPERPILOT_EMBEDDING_DIM=256

# --- Storage ---
PAPERPILOT_DATA_DIR=data

# --- Retrieval / chunking tuning ---
PAPERPILOT_CHUNK_TOKENS=400
PAPERPILOT_CHUNK_OVERLAP=60
PAPERPILOT_TOP_K=8
